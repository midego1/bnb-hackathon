{
  "name": "keyescrow-inspector-agent",
  "version": "0.1.0",
  "private": true,
  "description": "KeyScrow Inspector: the AI scooter return inspection as a BNB Chain agent (ERC-8004 identity, A2A + MCP faces)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "card": "tsx scripts/card.ts",
    "call:mcp": "tsx scripts/call-mcp.ts",
    "call:a2a": "tsx scripts/call-a2a.ts",
    "register": "tsx scripts/register.ts",
    "rehearse": "bash scripts/rehearse.sh",
    "verify": "tsx scripts/verify.ts",
    "demo:tools": "tsx scripts/demo-tools.ts",
    "cf:preview": "WRANGLER_SEND_METRICS=false CLOUDFLARE_API_TOKEN= CLOUDFLARE_ACCOUNT_ID= wrangler dev --ip 127.0.0.1 --port ${CF_AGENT_PREVIEW_PORT:-8788} --local --show-interactive-dev-session=false",
    "cf:deploy": "node ../web/scripts/cf.mjs deploy --agent"
  },
  "packageManager": "pnpm@12.23.0",
  "dependencies": {
    "@a2a-js/sdk": "0.3.14",
    "@bnbagent/sdk": "0.6.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "viem": "^2.58.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "wrangler": "4.159.0"
  }
}
