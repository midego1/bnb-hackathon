# Copy to .env (root, for Foundry scripts) and web/.env.local (for Next.js). Names only — never commit values.

# --- Chain / deploy (server-side & scripts only) ---
BSC_TESTNET_RPC_URL=
OPBNB_TESTNET_RPC_URL=
# Used by `pnpm chain:deploy` / contracts/script/Deploy.s.sol. On local anvil (31337) everything defaults.
RPC_URL=
# BSC testnet deploy (`pnpm deploy:testnet:check` / `pnpm deploy:testnet`, see docs/DEPLOY.md).
# Deployer wallet: exactly one of DEPLOYER_ACCOUNT (cast wallet keystore name, preferred), DEPLOYER_KEYSTORE (path to a
# keystore file) or PRIVATE_KEY. DEPLOYER_ADDRESS (public address) is required and cross-checked against the wallet.
DEPLOYER_ACCOUNT=
DEPLOYER_KEYSTORE=
DEPLOYER_PASSWORD_FILE=
DEPLOYER_ADDRESS=
# Raw deployer key. Optional on anvil (defaults to anvil account 0); discouraged elsewhere. Testnet only.
PRIVATE_KEY=
# Must be `true` before Deploy.s.sol will broadcast to BSC / opBNB testnet (mainnets and other chains always refused).
ALLOW_NON_LOCAL_BROADCAST=
# `true` to let `pnpm deploy:testnet` replace an existing contracts/deployments/97.json.
FORCE_REDEPLOY=
# Platform roles. Required off anvil (no defaults, anvil accounts refused): factory owner, KeyEscrow treasury
# (fee recipient), KeyEscrow dispute desk (default arbiter). FEE_BPS: one-time fee in bps of one month's rent.
FACTORY_OWNER=
FEE_RECIPIENT=
DEFAULT_ARBITER=
FEE_BPS=
# Fleet Vault (BKK-FLEET-1 shares). Optional: operator gets the maintenance fee (default FEE_RECIPIENT off anvil,
# anvil account 1 locally); fee in bps of vault income (default 1000, max 3000); share token name/symbol.
FLEET_OPERATOR=
FLEET_OPERATOR_FEE_BPS=
FLEET_NAME=
FLEET_SYMBOL=
# Contract verification on BscScan testnet (Etherscan API V2 key). VERIFIER_URL optionally overrides the endpoint.
BSCSCAN_API_KEY=
VERIFIER_URL=

# --- Price feeds for GET /api/price (server-side only, never NEXT_PUBLIC_) ---
# Order: Atlas on-chain feeds (all three of RPC + USDT/USD + BNB/USD set) -> CoinMarketCap -> static mock.
ATLAS_RPC_URL=
ATLAS_FEED_USDT_USD=
ATLAS_FEED_BNB_USD=
# Optional; without it THB is derived from CoinMarketCap or the static rate.
ATLAS_FEED_USD_THB=
# Atlas answers older than this many seconds are rejected as stale (default 3600).
ATLAS_MAX_AGE_SECONDS=
# CoinMarketCap Pro API key (CMC_PRO_API_KEY is accepted as an alias).
CMC_API_KEY=
# In-memory cache TTL in seconds (default 60). Each CMC refresh costs 2 credits.
PRICE_CACHE_TTL_SECONDS=
# GET /api/risk quote cache in seconds (default 120; 2 credits per refresh). Setting CMC_API_KEY turns live CMC calls on.
RISK_CACHE_TTL_SECONDS=
# Leave empty (real API). Only http://127.0.0.1:<port> is accepted otherwise, for local fixture replay.
CMC_API_BASE=

# --- Cournot Intelligence Oracle for the deposit buffer (server-side only, no key needed for 3 free calls per IP) ---
# `1` allows live probability calls (POST /api/cournot, from the risk panel's button). Anything else: stored answers only.
COURNOT_LIVE=
# Max live probability calls this server makes without a prepaid key (default 3 = the free allowance).
COURNOT_MAX_LIVE_CALLS=
# Optional prepaid Cournot key (ck_live_...) and API base (default https://interface.cournot.ai).
COURNOT_API_KEY=
COURNOT_API_BASE=

# --- Living Brain: the AI inspector's per-scooter memory (server-side only; local file when unset) ---
# Key from the Living Brain dashboard; SUBJECT_ID = any UUID you pick; BRAIN_ID from POST /v1/brains (see README).
LIVING_BRAIN_API_KEY=
LIVING_BRAIN_SUBJECT_ID=
LIVING_BRAIN_BRAIN_ID=
LIVING_BRAIN_BASE_URL=

# Sponsor call logs + stored Cournot answers + local inspection memory (default web/.sponsor-logs, gitignored).
SPONSOR_LOG_DIR=

# --- AI settlement for POST /api/settlement (server-side only; deterministic mock when no key) ---
# Provider: "anthropic" (default) or "mock".
VISION_LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5.
VISION_LLM_MODEL=

# --- Ask AI, the in-app assistant (server-side only, docs/ASSISTANT.md). Uses ANTHROPIC_API_KEY above; without it (or
# with ASSISTANT_MOCK=1) a scripted demo model answers, offline. ---
# claude-sonnet-5-5 (default) or claude-haiku-5-5.
ASSISTANT_MODEL=
# Tokens per UTC day for the whole server (default 1000000; cache reads count a tenth).
ASSISTANT_DAILY_TOKENS=
# 1 = always use the demo model, even with a key.
ASSISTANT_MOCK=

# --- KeyEscrow Inspector agent: ERC-8004 identity that signs settlement reports (server-side only, docs/AGENT.md) ---
# Report-signing key for POST /api/settlement and the agent. Unset -> reports are unsigned (as before). Never NEXT_PUBLIC_.
INSPECTOR_PRIVATE_KEY=
# From `pnpm agent:register` (agent/deployments/97.json): agent id and eip155:97:<Identity Registry>.
INSPECTOR_AGENT_ID=
INSPECTOR_AGENT_REGISTRY=
# Registration (`pnpm agent:register:check` / `pnpm agent:register`; uses the DEPLOYER_* wallet above and
# ALLOW_NON_LOCAL_BROADCAST): public address of INSPECTOR_PRIVATE_KEY, and the agent's public base URL.
INSPECTOR_SIGNER_ADDRESS=
AGENT_PUBLIC_URL=
# Agent server (`pnpm agent:dev`), default 127.0.0.1:8790.
AGENT_HOST=
AGENT_PORT=

# --- Rental actions as agent tools (/api/v1, MCP tools on the agent; read-only RPC, never a key; docs/AGENT.md) ---
# Default chain when a call names none: 31337 or 97 (default: NEXT_PUBLIC_CHAIN_ID, else 31337).
KEYESCROW_CHAIN_ID=
# Server-side RPC per chain. Defaults: 31337 -> NEXT_PUBLIC_RPC_URL or http://127.0.0.1:8545,
# 97 -> https://bsc-testnet-rpc.publicnode.com (needs eth_simulateV1; the bnbchain.org data-seed nodes refuse eth_getLogs).
KEYESCROW_RPC_URL_31337=
KEYESCROW_RPC_URL_97=

# --- Server-side chain index (GET /api/chain/index; every page's event reads; uses KEYESCROW_RPC_URL_<chainId>) ---
# Max blocks per eth_getLogs (default 5000; a window the RPC still refuses is split). Ignored on anvil (one query).
CHAIN_INDEX_BLOCK_RANGE=
# Log queries in flight at once (default 2).
CHAIN_INDEX_CONCURRENCY=
# How long a snapshot is served without touching the RPC, ms (default 4000 on 97, 0 on anvil).
CHAIN_INDEX_TTL_MS=

# --- BNB Greenfield evidence storage (server-side only; local fallback when empty) ---
GREENFIELD_RPC_URL=
GREENFIELD_CHAIN_ID=
GREENFIELD_BUCKET=
GREENFIELD_PRIVATE_KEY=
# Optional storage-provider endpoint override.
GREENFIELD_SP_ENDPOINT=
# Local fallback directory (default web/.evidence, gitignored) and per-file size limit in bytes (default 10 MiB).
EVIDENCE_DIR=
EVIDENCE_MAX_BYTES=

# --- Write-only secrets page /settings/secrets (docs/SETUP.md). Local paseo-box units only, never Cloudflare. ---
# `1` switches it on (web/.env.local for :3000; testnet-web.sh sets it for :3001). Paths default to the main checkout.
SETTINGS_SECRETS_ENABLED=
SECRETS_ENV_FILE=
SECRETS_WEB_ENV_FILE=
SETTINGS_SECRETS_STATE_DIR=
SETTINGS_SECRETS_RESTART=
SETTINGS_SECRETS_HOSTS=
# Not read by the app yet; settable from the secrets page.
PINATA_JWT=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Public frontend config (non-secret identifiers only) ---
# Target chain for the app: 31337 (anvil) or 97 (BSC testnet); addresses from contracts/deployments/<chainId>.json.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public origin of the deployed site (build time, optional), e.g. https://keyescrow.example. Makes the marketing
# page's social-card image URL absolute. Not a secret.
SITE_URL=
# Anvil RPC the browser talks to (default http://127.0.0.1:8545). NEXT_PUBLIC_ANVIL_RPC_URL is still read as an alias.
NEXT_PUBLIC_RPC_URL=
# `1` shows the local-only "Demo accounts" bar (act as anvil owner (landlord) / renter (tenant) / dispute desk). Never set it for testnet.
NEXT_PUBLIC_DEV_ACCOUNTS=
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=
NEXT_PUBLIC_OPBNB_TESTNET_RPC_URL=
NEXT_PUBLIC_ESCROW_FACTORY_ADDRESS=
NEXT_PUBLIC_MOCK_USDT_ADDRESS=
NEXT_PUBLIC_FLEET_VAULT_ADDRESS=
