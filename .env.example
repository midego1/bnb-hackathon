# Copy to .env (root, for Foundry scripts) and web/.env.local (for Next.js). Names only — never commit values.

# --- Chain / deploy (server-side & scripts only) ---
BSC_TESTNET_RPC_URL=
OPBNB_TESTNET_RPC_URL=
# Used by `pnpm chain:deploy` / contracts/script/Deploy.s.sol. On local anvil (31337) everything defaults.
RPC_URL=
# BSC testnet deploy (`pnpm deploy:testnet:check` / `pnpm deploy:testnet`, see docs/DEPLOY.md).
# Deployer wallet: exactly one of DEPLOYER_ACCOUNT (cast wallet keystore name, preferred), DEPLOYER_KEYSTORE (path to a
# keystore file) or PRIVATE_KEY. DEPLOYER_ADDRESS (public address) is required and cross-checked against the wallet.
DEPLOYER_ACCOUNT=
DEPLOYER_KEYSTORE=
DEPLOYER_PASSWORD_FILE=
DEPLOYER_ADDRESS=
# Raw deployer key. Optional on anvil (defaults to anvil account 0); discouraged elsewhere. Testnet only.
PRIVATE_KEY=
# Must be `true` before Deploy.s.sol will broadcast to BSC / opBNB testnet (mainnets and other chains always refused).
ALLOW_NON_LOCAL_BROADCAST=
# `true` to let `pnpm deploy:testnet` replace an existing contracts/deployments/97.json.
FORCE_REDEPLOY=
# Platform roles. Required off anvil (no defaults, anvil accounts refused): factory owner, KeyEscrow treasury
# (fee recipient), KeyEscrow dispute desk (default arbiter). FEE_BPS: one-time fee in bps of one month's rent.
FACTORY_OWNER=
FEE_RECIPIENT=
DEFAULT_ARBITER=
FEE_BPS=
# Contract verification on BscScan testnet (Etherscan API V2 key). VERIFIER_URL optionally overrides the endpoint.
BSCSCAN_API_KEY=
VERIFIER_URL=

# --- Price feeds for GET /api/price (server-side only, never NEXT_PUBLIC_) ---
# Order: Atlas on-chain feeds (all three of RPC + USDT/USD + BNB/USD set) -> CoinMarketCap -> static mock.
ATLAS_RPC_URL=
ATLAS_FEED_USDT_USD=
ATLAS_FEED_BNB_USD=
# Optional; without it THB is derived from CoinMarketCap or the static rate.
ATLAS_FEED_USD_THB=
# CoinMarketCap Pro API key (CMC_PRO_API_KEY is accepted as an alias).
CMC_API_KEY=
# In-memory cache TTL in seconds (default 60). Each CMC refresh costs 2 credits.
PRICE_CACHE_TTL_SECONDS=

# --- AI settlement for POST /api/settlement (server-side only; deterministic mock when no key) ---
# Provider: "anthropic" (default) or "mock".
VISION_LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5.
VISION_LLM_MODEL=

# --- KeyEscrow Inspector agent: ERC-8004 identity that signs settlement reports (server-side only, docs/AGENT.md) ---
# Report-signing key for POST /api/settlement and the agent. Unset -> reports are unsigned (as before). Never NEXT_PUBLIC_.
INSPECTOR_PRIVATE_KEY=
# From `pnpm agent:register` (agent/deployments/97.json): agent id and eip155:97:<Identity Registry>.
INSPECTOR_AGENT_ID=
INSPECTOR_AGENT_REGISTRY=
# Registration (`pnpm agent:register:check` / `pnpm agent:register`; uses the DEPLOYER_* wallet above and
# ALLOW_NON_LOCAL_BROADCAST): public address of INSPECTOR_PRIVATE_KEY, and the agent's public base URL.
INSPECTOR_SIGNER_ADDRESS=
AGENT_PUBLIC_URL=
# Agent server (`pnpm agent:dev`), default 127.0.0.1:8790.
AGENT_HOST=
AGENT_PORT=

# --- BNB Greenfield evidence storage (server-side only; local fallback when empty) ---
GREENFIELD_RPC_URL=
GREENFIELD_CHAIN_ID=
GREENFIELD_BUCKET=
GREENFIELD_PRIVATE_KEY=
# Optional storage-provider endpoint override.
GREENFIELD_SP_ENDPOINT=
# Local fallback directory (default web/.evidence, gitignored) and per-file size limit in bytes (default 10 MiB).
EVIDENCE_DIR=
EVIDENCE_MAX_BYTES=

# --- Public frontend config (non-secret identifiers only) ---
# Target chain for the app: 31337 (anvil) or 97 (BSC testnet); addresses from contracts/deployments/<chainId>.json.
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Anvil RPC the browser talks to (default http://127.0.0.1:8545). NEXT_PUBLIC_ANVIL_RPC_URL is still read as an alias.
NEXT_PUBLIC_RPC_URL=
# `1` shows the local-only "Demo accounts" bar (act as anvil owner (landlord) / renter (tenant) / dispute desk). Never set it for testnet.
NEXT_PUBLIC_DEV_ACCOUNTS=
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=
NEXT_PUBLIC_OPBNB_TESTNET_RPC_URL=
NEXT_PUBLIC_ESCROW_FACTORY_ADDRESS=
NEXT_PUBLIC_MOCK_USDT_ADDRESS=
