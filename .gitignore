# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
keystore/

# Local agent / tooling state
.orca/
.claude/settings.local.json

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/*/31337/
contracts/broadcast/**/dry-run/
# Local anvil deployments churn on every redeploy; *.example.json shows the shape (fresh anvil, deterministic).
contracts/deployments/31337.json
contracts/deployments/31337.demo.json
contracts/deployments/.e2e/
lcov.info
# `pnpm coverage` output (lcov reports)
coverage/

# Node / Next.js
node_modules/
web/.next/
web/out/
*.tsbuildinfo
web/next-env.d.ts

# Local evidence fallback storage
web/.evidence/
# Local scooter catalogue + booking requests (/api/fleet)
web/.fleet/

# OS / editor
.DS_Store
.idea/
.vscode/

# Regenerated by `next dev`
web/AGENTS.md
web/CLAUDE.md

# root has no deps; pnpm script runs create a stray lockfile
/pnpm-lock.yaml
contracts/broadcast/**/run-[0-9]*.json
contracts/broadcast/**/*.recovery.lock

# Cloudflare Workers (wrangler local state, OpenNext output; see docs/CLOUDFLARE.md)
.wrangler/
web/.open-next/
.dev.vars*
!.dev.vars.example
