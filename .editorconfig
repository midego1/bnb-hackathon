# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# forge fmt (contracts/foundry.toml [fmt]: line_length = 110)
[*.sol]
indent_size = 4
max_line_length = 110

# Two trailing spaces are a Markdown line break.
[*.md]
trim_trailing_whitespace = false

# Demo evidence is hashed on-chain byte for byte (.gitattributes): never touch it.
[web/public/demo/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
