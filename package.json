{
  "name": "keyescrow",
  "private": true,
  "description": "Rental deposit and rent escrow on BNB Chain",
  "license": "MIT",
  "scripts": {
    "setup": "git submodule update --init --recursive && pnpm -C web install && pnpm -C agent install && cd contracts && forge build",
    "build": "cd contracts && forge build && cd .. && pnpm -C web build",
    "test": "cd contracts && forge test",
    "dev": "pnpm -C web dev",
    "chain:anvil": "anvil --host 127.0.0.1 --port ${ANVIL_PORT:-8545}",
    "chain:deploy": "cd contracts && forge script script/Deploy.s.sol --rpc-url ${RPC_URL:-http://127.0.0.1:8545} --broadcast",
    "chain:seed": "cd contracts && forge script script/Seed.s.sol --rpc-url ${RPC_URL:-http://127.0.0.1:8545} --broadcast",
    "deploy:testnet:check": "bash contracts/script/testnet.sh check",
    "deploy:testnet": "bash contracts/script/testnet.sh deploy",
    "deploy:testnet:verify": "bash contracts/script/testnet.sh verify",
    "deploy:testnet:rehearse": "bash contracts/script/testnet.sh rehearse",
    "e2e:chain": "node web/scripts/e2e-chain.mts",
    "agent:dev": "pnpm -C agent dev",
    "agent:test": "pnpm -C agent test",
    "agent:card": "pnpm -C agent card",
    "agent:call:mcp": "pnpm -C agent call:mcp",
    "agent:call:a2a": "pnpm -C agent call:a2a",
    "agent:verify": "pnpm -C agent verify",
    "agent:register:check": "pnpm -C agent register check",
    "agent:register": "pnpm -C agent register register",
    "agent:rehearse": "pnpm -C agent rehearse"
  },
  "packageManager": "pnpm@12.23.0"
}
